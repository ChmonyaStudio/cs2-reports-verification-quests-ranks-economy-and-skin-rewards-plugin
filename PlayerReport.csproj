<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PlayerReport</AssemblyName>
    <RootNamespace>ReportPlugin</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Metadata -->
    <Product>CS2 Player Report</Product>
    <Version>1.0.0</Version>
    <Authors>Chmonya</Authors>
    <Description>Player reports, verification, quests, ranks, economy for CS2 servers</Description>
    <Copyright>Copyright (c) 2026 Chmonya</Copyright>

    <!-- Build settings -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.302" />
    <PackageReference Include="MySqlConnector" Version="2.3.5" />
  </ItemGroup>

</Project>
